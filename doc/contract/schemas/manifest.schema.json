{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thin-edge.io/ot-connector/manifest.schema.json",
  "title": "OT Connector Device Manifest",
  "description": "Retained per-device manifest published to te/device/<device>/ot/<protocol>/manifest (contract §8.2): what the device is and what its points are, so a consumer never needs the configuration file and a sample carries only what changes per read.",
  "type": "object",
  "required": [
    "contract",
    "protocol",
    "service",
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "string",
      "const": "0.2",
      "description": "The contract version the connector implements."
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "description": "The connector service serving the device (contract §6.3)."
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "The device's declared type (§3.1), when it has one."
    },
    "info": {
      "type": "object",
      "description": "The connector's device descriptor (transport/address details) from its connect report, when seen."
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The thin-edge command types this device answers (§6.6), e.g. [\"ot_write\", \"ot_write_batch\"] — including any configured aliases. The connector publishes a retained capability marker on te/device/<device>///cmd/<type> for each of them, and the registration flow advertises these instead of a hard-coded list."
    },
    "points": {
      "type": "object",
      "description": "Every configured point, keyed by point id.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "access"
        ],
        "additionalProperties": false,
        "properties": {
          "datatype": {
            "enum": [
              "bool",
              "int8",
              "uint8",
              "int16",
              "uint16",
              "int32",
              "uint32",
              "int64",
              "uint64",
              "float32",
              "float64",
              "string",
              "bytes"
            ]
          },
          "access": {
            "enum": [
              "read",
              "write",
              "read_write"
            ]
          },
          "unit": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "description": "Engineering-unit bounds (§5.3): what the cloud form renders as minimum/maximum AND what the connector enforces on write, so the two cannot disagree.",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "publish": {
            "type": "object",
            "additionalProperties": false,
            "description": "The per-signal publish policy the connector runtime has ALREADY applied to this point's sample stream (§5.4). Published so a consumer can tell 'nothing changed' from 'nothing was read'.",
            "properties": {
              "on_change": {
                "type": "boolean"
              },
              "deadband": {
                "type": "number"
              },
              "min_interval": {
                "type": "string"
              },
              "debounce": {
                "type": "string"
              }
            }
          },
          "measurement": {
            "description": "Where the signal lands as a measurement (§5.5): false to keep it out of the measurements, or a table naming its group and series.",
            "oneOf": [
              {
                "const": false
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "group": {
                    "type": "string"
                  },
                  "series": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "meta": {
            "type": "object",
            "description": "The point's free-form meta table, verbatim — the site's own tags."
          },
          "parameter": {
            "type": "object",
            "required": [
              "sets"
            ],
            "additionalProperties": false,
            "description": "Present when the point is a parameter (§5.2): the sets it belongs to, resolved by the connector.",
            "properties": {
              "sets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]+$"
                }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "contract": "0.2",
      "protocol": "modbus",
      "service": "tedge-dot-modbus",
      "type": "acme-meter-v2",
      "info": {
        "transport": "tcp",
        "host": "192.168.0.10",
        "port": 502,
        "unit_id": 1
      },
      "points": {
        "boiler_temp": {
          "datatype": "float32",
          "access": "read",
          "unit": "°C",
          "name": "Boiler temp",
          "publish": {
            "on_change": true,
            "deadband": 0.5
          },
          "measurement": {
            "group": "Environment",
            "series": "Temperature"
          },
          "meta": {
            "asset_tag": "B-17"
          }
        },
        "setpoint": {
          "datatype": "uint16",
          "access": "read_write",
          "range": {
            "min": 0,
            "max": 30000
          },
          "parameter": {
            "sets": [
              "acme_meter_v2_control_parameters"
            ]
          }
        }
      },
      "commands": [
        "ot_write",
        "ot_write_batch"
      ]
    }
  ]
}
