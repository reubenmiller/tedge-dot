{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thin-edge.io/ot-connector/status.schema.json",
  "title": "OT Connector Status & Capability Messages",
  "description": "Retained status, link, and capability descriptor messages published by a connector.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/link" },
    { "$ref": "#/$defs/capabilities" }
  ],
  "$defs": {
    "health": {
      "title": "Service health",
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": {
        "status": { "enum": ["up", "down"] },
        "time": { "type": "string", "format": "date-time" }
      }
    },
    "link": {
      "title": "Device link status",
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["connected", "disconnected", "degraded"] },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "The device's declared type (§3.1), when it has one — so the registration flow can use it as the thin-edge entity type, and a consumer can name the device's parameter sets before any sample arrives."
        },
        "points": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "The id of every point configured on the device, in configuration order. Republished with the status whenever the configuration changes, so a consumer keeping state per point (the parameter twin) can tell a point that was removed from one that is merely not sampled — a write-only point never is."
        },
        "since": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "info": {
          "type": "object",
          "description": "Optional device descriptor (transport/address details) supplied by the connector; flows can forward it into a digital-twin fragment."
        }
      }
    },
    "capabilities": {
      "title": "Capability descriptor",
      "type": "object",
      "required": ["protocol", "version", "modes"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["raw", "typed"] },
          "uniqueItems": true
        },
        "datatypes": {
          "type": "array",
          "items": {
            "enum": [
              "bool",
              "int8", "uint8",
              "int16", "uint16",
              "int32", "uint32",
              "int64", "uint64",
              "float32", "float64",
              "string", "bytes"
            ]
          },
          "uniqueItems": true
        },
        "point_kinds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "command_verbs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "subscribe": { "type": "boolean", "default": false },
        "point_labels": {
          "type": "array",
          "description": "Human-readable labels for the configured points (§3.1 name / description), so a consumer can show something friendlier than the point id. Only points declaring one of them appear, and each entry carries only the fields it declares; no entry means the id is the label. Published here, once and retained, rather than echoed in every sample: the labels are static and a sample is a time series.",
          "items": {
            "type": "object",
            "required": ["device", "point"],
            "additionalProperties": false,
            "properties": {
              "device": { "type": "string", "minLength": 1 },
              "point": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "parameter_keys": {
          "type": "array",
          "description": "The configured points that name their own key inside their parameter sets (§5.2 meta.parameter.key), with the set / group that name those sets as configured. A consumer learns from it which point a key belongs to before the point samples: after a restart, since samples are not retained, and for a write-only point, which never samples. Points without a key are omitted; their key is their id.",
          "items": {
            "type": "object",
            "required": ["device", "point", "key"],
            "additionalProperties": false,
            "properties": {
              "device": { "type": "string", "minLength": 1 },
              "point": { "type": "string", "minLength": 1 },
              "key": { "type": "string", "minLength": 1 },
              "set": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              },
              "group": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    { "status": "up", "time": "2026-05-30T09:59:00.000Z" },
    { "status": "connected", "since": "2026-05-30T09:59:00.000Z" },
    {
      "protocol": "modbus",
      "version": "0.1.0",
      "modes": ["raw", "typed"],
      "datatypes": ["bool", "int16", "uint16", "int32", "uint32", "float32", "float64"],
      "point_kinds": ["coil", "discrete_input", "holding_register", "input_register"],
      "command_verbs": ["write"],
      "features": ["polling", "bitfield"],
      "subscribe": false,
      "point_labels": [
        { "device": "plc-1", "point": "boiler_temp",
          "name": "Boiler temp", "description": "Outlet temperature after the heat exchanger" }
      ]
    }
  ]
}
