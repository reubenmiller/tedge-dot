# Full Cumulocity end-to-end image: thin-edge.io demo base + the OT connector, its thin-edge
# flows, and the Cumulocity operation shims. This REPLACES the legacy Python plugin: no Python
# Modbus code is installed here.
#
# IMPL selects the implementation under test, exactly as the connector e2e stacks do:
#
#   rust (default) — the cross-compiled .deb from dist/; run `just build` first.
#   c              — the C implementation (impl/c/), compiled in a builder stage here, so
#                    nothing has to be built beforehand and dist/ is not read at all
#                    (BuildKit skips the stage that COPYs it).
#
# The flows come from the connector install itself (the .deb for rust; reproduced by hand for
# c, as that stage does for the binary, unit and config dir) — so this suite exercises the
# packaged layout, not a source-tree copy of it. Everything after the install is shared:
# the same connector config, operator steps and operation shims for both implementations —
# `just test-cloud modbus` / `just test-cloud-c modbus`.
#
# Build context is the repository root. Docker selects the correct arch via TARGETARCH.
ARG BASE_REGISTRY=public.ecr.aws/docker/library
ARG DEMO_IMAGE=ghcr.io/thin-edge/tedge-demo-main-systemd:latest
ARG IMPL=rust

# --- C connector build (only when IMPL=c) --------------------------------------------------
# Debian bookworm matches the demo image, so the binary links against the same libc/libmodbus.
# Only the modbus module is compiled in — this is the modbus cloud harness.
FROM ${BASE_REGISTRY}/debian:bookworm AS build-c
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config git ca-certificates python3 \
        libmodbus-dev libmosquitto-dev libcjson-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY impl/c /src/impl/c
COPY impl/rust/crates/sdk/conformance /src/impl/rust/crates/sdk/conformance
RUN cmake -S impl/c -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DTDOT_MODBUS=ON -DTDOT_OPCUA=OFF -DTDOT_PROFIBUS=OFF \
        -DTDOT_CANBUS=OFF -DTDOT_CANOPEN=OFF \
    && cmake --build build --target tedge-dot \
    && cp build/tedge-dot /usr/local/bin/tedge-dot

# --- connector install, Rust: the packaged .deb (binary + systemd unit + default configs) ---
# Copy both amd64 and arm64 debs; the shell selects the right one at install time via
# `dpkg --print-architecture` (Docker COPY does not apply globs after variable substitution).
FROM ${DEMO_IMAGE} AS connector-rust
RUN mkdir -p /opt/debs/
COPY dist/*.deb /opt/debs/
RUN arch=$(dpkg --print-architecture) \
    && apt-get update \
    && apt-get install -y --no-install-recommends --allow-downgrades \
        /opt/debs/tedge-dot-rs_*_linux_${arch}.deb \
    && rm -rf /opt/debs \
    && rm -rf /var/lib/apt/lists/*

# --- connector install, C: the same layout the C package would produce ---------------------
# impl/c/packaging/nfpm.yaml makes the C package (tedge-dot-c) interchangeable with the Rust
# one (tedge-dot-rs): same binary path, same unit, same config directory. This stage
# reproduces that layout by hand rather than building a package inside the image, which is
# also what lets the Robot guard below tell the two apart by whether a package is installed.
FROM ${DEMO_IMAGE} AS connector-c
RUN apt-get update \
    && apt-get install -y --no-install-recommends libmodbus5 libmosquitto1 libcjson1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build-c /usr/local/bin/tedge-dot /usr/bin/tedge-dot
COPY packaging/tedge-dot.service /lib/systemd/system/tedge-dot.service
# The service runs as tedge and persists management-command config changes back into this
# directory (define-device), so tedge must own it.
RUN chmod 0755 /usr/bin/tedge-dot \
    && chmod 0644 /lib/systemd/system/tedge-dot.service \
    && install -d -o tedge -g tedge -m 0755 /etc/tedge/plugins/ot
# The flows the package deploys: the core pipeline active in the c8y mapper, the opt-in
# alarm/event flows parked in /usr/share for the operator. Same split as nfpm.yaml.
COPY flows/ot-measurement       /etc/tedge/mappers/c8y/flows/ot-measurement
COPY flows/ot-registration      /etc/tedge/mappers/c8y/flows/ot-registration
COPY flows/ot-parameter-update  /etc/tedge/mappers/c8y/flows/ot-parameter-update
COPY flows/ot-parameter-result  /etc/tedge/mappers/c8y/flows/ot-parameter-result
COPY flows/ot-parameter-state   /etc/tedge/mappers/c8y/flows/ot-parameter-state
COPY flows/ot-alarm             /usr/share/tedge-dot/flows/ot-alarm
COPY flows/ot-event             /usr/share/tedge-dot/flows/ot-event
RUN chown -R tedge:tedge /etc/tedge/mappers/c8y/flows /usr/share/tedge-dot/flows

# --- everything below is shared by both implementations ------------------------------------
FROM connector-${IMPL}

# jq + curl are runtime dependencies of the Cloud Fieldbus import shim (c8y-fieldbus-import).
# tedge-parameter-plugin (thin-edge community repo) owns the c8y_ParameterUpdate operation
# template; the OT child devices advertise its `parameter_update` command and the flows serve it
# (see doc/rfc/0003-parameter-writes.md).
RUN apt-get update \
    && apt-get install -y --no-install-recommends jq curl tedge-parameter-plugin \
    && rm -rf /var/lib/apt/lists/*

# --- Connector configuration pointing at the simulator -------------------------------------
# The tedge-dot supervisor launches one connector per /etc/tedge/plugins/ot/*.toml.
# Replace the packaged defaults with the single modbus config for this harness (host "simulator").
COPY cloud/modbus/modbus.toml /etc/tedge/plugins/ot/modbus.toml
RUN rm -f /etc/tedge/plugins/ot/canbus.toml /etc/tedge/plugins/ot/canopen.toml \
    /etc/tedge/plugins/ot/opcua.toml /etc/tedge/plugins/ot/profibus.toml

# --- thin-edge flows that map the generic OT envelopes to the thin-edge data model ----------
# Nothing is copied from the source tree here: the flows come from the connector install above,
# exactly as they reach a real device. So this suite also tests the packaging: if the package
# stopped shipping a flow, registration/measurements/operations would fail here.
#
# What is left are the steps a real operator performs. First the opt-in flows, which ship inert
# in /usr/share/tedge-dot/flows/ because they need a per-signal threshold or event type:
RUN cp -Ra /usr/share/tedge-dot/flows/ot-alarm /usr/share/tedge-dot/flows/ot-event \
        /etc/tedge/mappers/c8y/flows/

# ...then the flow settings. Enable the c8y_ModbusDevice twin fragment on registration (the
# packaged params.toml.template next to it documents the rest).
COPY cloud/modbus/params/ot-registration.params.toml /etc/tedge/mappers/c8y/flows/ot-registration/params.toml

# --- Cumulocity operation shims (deployed as tedge operation templates) ---------------------
COPY operations/c8y_SetRegister          /etc/tedge/operations/c8y/c8y_SetRegister.template
COPY operations/c8y_SetCoil              /etc/tedge/operations/c8y/c8y_SetCoil.template
COPY operations/c8y_ModbusConfiguration  /etc/tedge/operations/c8y/c8y_ModbusConfiguration.template
COPY operations/c8y_SerialConfiguration  /etc/tedge/operations/c8y/c8y_SerialConfiguration.template
COPY operations/c8y_ModbusDevice         /etc/tedge/operations/c8y/c8y_ModbusDevice.template

# Cloud Fieldbus import shim executed by the c8y_ModbusDevice template: creates the child's
# external identity, fetches the c8y_ModbusDeviceType MO via the mapper's local c8y proxy, and
# drives the connector's define-device verb (gap G1 / RFC 0002 increment 1).
COPY operations/c8y-fieldbus-import      /usr/bin/c8y-fieldbus-import

# Gateway-level operations must exist WITHOUT the .template suffix so the mapper adds them to
# the main device's c8y_SupportedOperations and Cumulocity actually delivers the operations
# (templates alone are only instantiated per child device). Without this, a Cloud Fieldbus
# assignment stays PENDING forever.
RUN cd /etc/tedge/operations/c8y \
    && cp c8y_ModbusDevice.template c8y_ModbusDevice \
    && cp c8y_ModbusConfiguration.template c8y_ModbusConfiguration \
    && cp c8y_SerialConfiguration.template c8y_SerialConfiguration

RUN chmod 0644 /etc/tedge/operations/c8y/c8y_*.template \
    && chmod 0755 /usr/bin/c8y-fieldbus-import \
    && chown -R tedge:tedge /etc/tedge/mappers /etc/tedge/operations/c8y \
    && systemctl enable tedge-dot.service
