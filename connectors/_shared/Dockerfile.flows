# Cloud-free flows runner for the e2e harness: thin-edge.io's flows engine as a user-defined
# mapper (`tedge-mapper ot`, from /etc/tedge/mappers/ot/) running this repo's flows against the
# stack's broker. It lets the e2e suites exercise the whole device-side chain — command
# bridging, parameter bridge, twin/registration — without any cloud connection.
#
# User-defined mappers need a thin-edge build newer than the demo image's release, so tedge is
# installed from the `main` channel here. Build context is the repo root.
ARG BASE_REGISTRY=public.ecr.aws/docker/library
FROM ${BASE_REGISTRY}/debian:bookworm-slim

ARG TEDGE_CHANNEL=main
# Protocol this stack runs; kept for the image tag and the entrypoint, not for any flow.
ARG PROTOCOL=modbus

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates netcat-openbsd \
    && curl -fsSL https://thin-edge.io/install.sh | sh -s -- --channel ${TEDGE_CHANNEL} \
    && rm -rf /var/lib/apt/lists/*

# The flows, deployed exactly as they would be into a mapper's flows directory.
COPY flows/ot-measurement       /etc/tedge/mappers/ot/flows/ot-measurement
COPY flows/ot-registration      /etc/tedge/mappers/ot/flows/ot-registration
COPY flows/ot-alarm             /etc/tedge/mappers/ot/flows/ot-alarm
COPY flows/ot-event             /etc/tedge/mappers/ot/flows/ot-event
COPY flows/ot-parameter-update  /etc/tedge/mappers/ot/flows/ot-parameter-update
COPY flows/ot-parameter-result  /etc/tedge/mappers/ot/flows/ot-parameter-result
COPY flows/ot-parameter-state   /etc/tedge/mappers/ot/flows/ot-parameter-state

# Nothing to point at a protocol any more: the connector answers the thin-edge command topics
# itself (RFC 0006 §7), so a flow no longer has to know which protocol reaches a device.
RUN tedge config set mqtt.client.host broker \
    && tedge config set mqtt.client.port 1883 \
    && chown -R tedge:tedge /etc/tedge

COPY connectors/_shared/flows-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
